# ============================================================
# ATOMS LMS — Backend Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# ============================================================

# Spring Profile
SPRING_PROFILES_ACTIVE=dev

# Database
DB_URL=jdbc:postgresql://localhost:5433/atoms_lms
DB_USERNAME=atoms_lms_user
DB_PASSWORD=atoms_lms_user

# JWT — minimum 64 characters, generate with: openssl rand -base64 64
JWT_SECRET=

# Google OAuth2
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Gmail SMTP
GMAIL_USERNAME=
GMAIL_PASSWORD=

# Judge0 (Code Execution)
JUDGE0_API_KEY=

# Mailgun
MAILGUN_API_KEY=

# VdoCipher
VDOCIPHER_API_KEY=
VDOCIPHER_WEBHOOK_SECRET=

# Razorpay (use rzp_test_* for dev, rzp_live_* for prod)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# AiSensy (WhatsApp)
AISENSY_API_KEY=

# DigitalOcean Spaces
DO_SPACES_ACCESS_KEY=
DO_SPACES_SECRET_KEY=

# File Storage
FILE_UPLOAD_DIR=../uploads

# Application Base URL
APP_BASE_URL=http://localhost:9080
